<!DOCTYPE html> <!-- Indica que el documento utiliza HTML5 -->
<html lang="es">
<head>
    <!-- Configuración de caracteres y adaptación a diferentes pantallas -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Título y estilos de la página de reservas -->
    <title>Reservar un laboratorio | Instituto Superior de Comercio Francisco Araya Bennett</title>
    <link rel="stylesheet" href="Reservaciones.css">
</head>
<body>
    <!-- Contenedor general de la página -->
    <div class="page-shell">
        <!-- Encabezado con navegación hacia las demás páginas -->
        <header class="topbar">
            <nav class="nav" aria-label="Navegación principal">
                <a class="brand" href="../Informaciondelabs/index.html">
                    <img src="../Informaciondelabs/insuco.jpg" alt="Logo del liceo">
                    <span>Instituto Superior de Comercio Francisco Araya Bennett</span>
                </a>
                <div class="nav-links">
                    <a href="../Informaciondelabs/index.html">Inicio</a>
                    <a href="../Sobremi/yo.html">Sobre mí</a>
                    <a href="../Presentacion/Presentacion.html">Presentación</a>
                    <a href="../Contactarme/Comunicarme.html">Contacto</a>
                </div>
            </nav>
        </header>

        <!-- Contenido principal del formulario de reservas -->
        <main>
            <!-- Título y estado general de las solicitudes -->
            <section class="page-heading">
                <div>
                    <p class="eyebrow">Panel de solicitudes</p>
                    <h1>Reserva tu laboratorio</h1>
                    <p class="intro-text">Planifica el uso de los espacios de informática del liceo en pocos pasos.</p>
                </div>
                <div class="request-status"><span class="status-dot"></span> Solicitudes abiertas</div>
            </section>

            <!-- Resumen rápido de horarios y cantidad de laboratorios -->
            <section class="quick-stats" aria-label="Resumen de disponibilidad">
                <div><strong>05</strong><span>Laboratorios</span></div>
                <div><strong>08:00</strong><span>Inicio de jornada</span></div>
                <div><strong>17:00</strong><span>Cierre de jornada</span></div>
                <div><strong>24 h</strong><span>Tiempo de respuesta</span></div>
            </section>

            <!-- Formulario de solicitud y horarios de referencia -->
            <section class="booking-layout" aria-label="Solicitud de reserva">
                <form class="booking-form" action="../Reservaconexisto/exito en la reserva!.html" method="get">
                    <div class="form-heading">
                        <span class="step-label">PASO 1 DE 2</span>
                        <h2>Datos de la solicitud</h2>
                        <p>Elige el espacio y el momento que necesitas.</p>
                    </div>

                    <div class="field-grid">
                        <label>
                            Laboratorio
                            <select name="laboratorio" required>
                                <option value="" selected disabled>Selecciona un laboratorio</option>
                                <option value="laboratorio-1">Laboratorio 1</option>
                                <option value="laboratorio-2">Laboratorio 2</option>
                                <option value="laboratorio-3">Laboratorio 3</option>
                                <option value="laboratorio-4">Laboratorio 4</option>
                                <option value="laboratorio-5">Laboratorio 5</option>
                            </select>
                        </label>
                        <label>
                            Curso o grupo
                            <input type="text" name="curso" placeholder="Ej. 4° medio H" required>
                        </label>
                    </div>

                    <div class="field-grid">
                        <label>
                            Fecha
                            <input type="date" name="fecha" required>
                        </label>
                        <label>
                            Horario
                            <select name="horario" required>
                                <option value="" selected disabled>Selecciona un horario</option>
                                <option value="08-00">08:00 - 09:30</option>
                                <option value="09-45">09:45 - 11:15</option>
                                <option value="11-30">11:30 - 13:00</option>
                                <option value="14-00">14:00 - 15:30</option>
                                <option value="15-45">15:45 - 17:00</option>
                            </select>
                        </label>
                    </div>

                    <label>
                        Nombre del profesor jefe
                        <input type="text" name="profesor-jefe" placeholder="Escribe el nombre completo" required>
                    </label>

                    <label>
                        Motivo de la reserva
                        <textarea name="motivo" rows="5" placeholder="Ej. Clase de computación, trabajo grupal o actividad escolar" required></textarea>
                    </label>

                    <!-- Envía la solicitud a la página de confirmación -->
                    <button type="submit">Solicitar laboratorio <span aria-hidden="true">→</span></button>
                    <p class="form-note" id="confirmacion">Recibirás una confirmación en un plazo máximo de 24 horas.</p>
            
                </form>

                <aside class="booking-aside">
                    <div class="aside-heading">
                        <span class="step-label">PASO 2 DE 2</span>
                        <h2>Horarios de referencia</h2>
                    </div>
                    <div class="schedule">
                        <div><span>08:00 - 09:30</span><b class="available">Disponible</b></div>
                        <div><span>09:45 - 11:15</span><b class="busy">En revisión</b></div>
                        <div><span>11:30 - 13:00</span><b class="available">Disponible</b></div>
                        <div><span>14:00 - 15:30</span><b class="available">Disponible</b></div>
                        <div><span>15:45 - 17:00</span><b class="busy">En revisión</b></div>
                    </div>
                    <h3>Importante</h3>
                    <ul>
                        <li>La reserva debe ser confirmada por el profesor jefe.</li>
                        <li>La disponibilidad puede cambiar durante el día.</li>
                    </ul>
                    <a class="back-link" href="../Informaciondelabs/index.html">← Ver disponibilidad</a>
                </aside>
            </section>
        </main>

        <!-- Pie de página de la institución -->
        <footer>&copy; Instituto Superior de Comercio Francisco Araya Bennett 2026</footer>
    </div>
</body>
</html>


css
:root {
	--azul-oscuro: #102847;
	--azul-medio: #1e4d7b;
	--azul-claro: #eaf2fc;
	--dorado: #d8b26a;
	--blanco: #ffffff;
	--texto: #1d2430;
	--muted: #526176;
}

* { box-sizing: border-box; }

body {
	margin: 0;
	color: var(--texto);
	font-family: Arial, Helvetica, sans-serif;
	background: linear-gradient(135deg, #edf4fb 0%, #ffffff 57%, #f7f0e4 100%);
}

.page-shell { min-height: 100vh; }
.topbar { padding: 1rem 2rem; background: linear-gradient(90deg, var(--azul-oscuro), var(--azul-medio)); box-shadow: 0 8px 24px rgba(16, 40, 71, 0.18); }
.nav { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.brand { display: flex; align-items: center; gap: 0.8rem; max-width: 430px; color: var(--blanco); font-weight: 700; line-height: 1.25; text-decoration: none; }
.brand img { width: 52px; height: 52px; flex: 0 0 52px; border: 2px solid rgba(255,255,255,0.7); border-radius: 50%; object-fit: cover; background: var(--blanco); }
.nav-links { display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: flex-end; }
.nav-links a { padding: 0.55rem 0.75rem; border-radius: 999px; color: #edf3ff; font-size: 0.9rem; text-decoration: none; }
.nav-links a:hover, .nav-links .active { background: rgba(255,255,255,0.14); }

main { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.2rem 4rem; }
.page-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 0 0 1.8rem; border-bottom: 1px solid #dce5ef; }
.eyebrow { margin: 0 0 0.7rem; color: var(--azul-medio); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
h1, h2, p { margin-top: 0; }
h1 { margin-bottom: 0.6rem; color: var(--azul-oscuro); font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -0.045em; }
.intro-text { max-width: 650px; margin-bottom: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.7; }
.request-status { padding: 0.7rem 1rem; border: 1px solid #b9e0cb; border-radius: 999px; color: #22633b; font-size: 0.86rem; font-weight: 700; background: #eefaf2; white-space: nowrap; }
.status-dot { display: inline-block; width: 8px; height: 8px; margin-right: 0.35rem; border-radius: 50%; background: #35a85b; }
.quick-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 1.5rem 0; border: 1px solid #dce5ef; background: var(--blanco); }
.quick-stats div { display: grid; gap: 0.25rem; padding: 1.2rem 1.3rem; border-right: 1px solid #dce5ef; }
.quick-stats div:last-child { border-right: 0; }
.quick-stats strong { color: var(--azul-oscuro); font-size: 1.35rem; }
.quick-stats span { color: var(--muted); font-size: 0.78rem; }

.booking-layout { display: grid; grid-template-columns: 1.35fr 0.75fr; gap: 1.5rem; margin-top: 2rem; }
.booking-form, .booking-aside { border-radius: 18px; box-shadow: 0 12px 30px rgba(16, 40, 71, 0.07); }
.booking-form { padding: 2rem; border-top: 4px solid var(--dorado); background: var(--blanco); }
.form-heading { margin-bottom: 1.6rem; }
.step-label { color: var(--azul-medio); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; }
.form-heading h2, .booking-aside h2 { margin: 0.35rem 0 0.5rem; color: var(--azul-oscuro); font-size: 1.85rem; }
.form-heading p { margin: 0; color: var(--muted); font-size: 0.9rem; }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
label { display: grid; gap: 0.45rem; margin-bottom: 1rem; color: var(--azul-oscuro); font-size: 0.88rem; font-weight: 700; }
input, select, textarea { width: 100%; padding: 0.85rem 0.9rem; border: 1px solid #ced9e8; border-radius: 8px; color: var(--texto); font: inherit; background: #fbfcfe; }
textarea { resize: vertical; }
input:focus, select:focus, textarea:focus { outline: 3px solid rgba(216,178,106,0.35); border-color: var(--azul-medio); }
button { border: 0; border-radius: 8px; padding: 0.9rem 1.2rem; color: var(--blanco); font: inherit; font-weight: 700; cursor: pointer; background: var(--azul-medio); }
button:hover { background: var(--azul-oscuro); }
button span { margin-left: 0.4rem; font-size: 1.2rem; }
.form-note { margin: 0.9rem 0 0; color: var(--muted); font-size: 0.78rem; }
.booking-aside { padding: 2rem; color: var(--muted); background: #f8fafc; }
.aside-heading { padding-bottom: 1.2rem; border-bottom: 1px solid #dce5ef; }
.booking-aside h2 { color: var(--azul-oscuro); }
.schedule { margin: 1.2rem 0 1.8rem; }
.schedule div { display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; padding: 0.8rem 0; border-bottom: 1px solid #e5ebf2; color: var(--azul-oscuro); font-size: 0.86rem; }
.schedule b { padding: 0.25rem 0.45rem; border-radius: 4px; font-size: 0.68rem; font-weight: 700; }
.available { color: #277044; background: #e5f5ea; }
.busy { color: #916b1e; background: #fff4d8; }
.booking-aside h3 { margin: 0 0 0.5rem; color: var(--azul-oscuro); font-size: 1rem; }
.booking-aside ul { margin: 1.5rem 0 2rem; padding-left: 1.2rem; line-height: 1.7; }
.booking-aside li { margin-bottom: 0.8rem; }
.back-link { color: var(--azul-medio); font-weight: 700; text-decoration: none; }
.back-link:hover { color: var(--azul-oscuro); }
footer { padding: 1.2rem 1rem; color: #e2e8f0; text-align: center; font-size: 0.9rem; background: var(--azul-oscuro); }

@media (max-width: 760px) {
	.topbar { padding: 1rem; }
	.nav { align-items: flex-start; flex-direction: column; }
	.nav-links { justify-content: flex-start; }
	main { padding: 1rem 1rem 3rem; }
	.page-heading { align-items: flex-start; flex-direction: column; }
	.quick-stats { grid-template-columns: 1fr 1fr; }
	.quick-stats div:nth-child(2) { border-right: 0; }
	.quick-stats div:nth-child(-n+2) { border-bottom: 1px solid #dce5ef; }
	.booking-layout, .field-grid { grid-template-columns: 1fr; }
	.booking-form, .booking-aside { padding: 1.5rem; }
}
