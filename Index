                            <td>11:15 - 17:00</td>
                            <td><span class="estado ok">disponible</span></td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </main>
        <!-- Tabla detallada con los cursos y el enlace a la ficha de cada laboratorio -->
        <section class="details-panel" aria-labelledby="details-title">
            <h2 id="details-title">Información de cada laboratorio</h2>
            <p class="details-intro">Selecciona un laboratorio para consultar sus características y normas de uso.</p>
            <!-- Este contenedor permite controlar el desplazamiento de la tabla en pantallas pequeñas -->
            <div class="details-table-wrapper">
                <table class="details-table">
                    <thead>
                        <tr>
                            <th scope="col">Laboratorio</th>
                            <th scope="col">Cursos que van</th>
                            <th scope="col">Información</th>
                        </tr>
                    </thead>
                    <!-- Cada botón abre la página individual del laboratorio seleccionado -->
