    <!-- Título que aparece en la pestaña del navegador -->
    <title>Laboratorios Instituto Superior de Comercio Francisco Araya Bennett</title>
    <!-- Conecta este documento con los estilos visuales del archivo CSS -->
    <link rel="stylesheet" href="index.css">
</head>
<body>
    <!-- Contenedor principal que agrupa toda la págin -->
    <div class="page-shell">
        <!-- Encabezado con el logo, el nombre del liceo y la navegación -->
        <header class="topbar">
            <nav class="nav">
                <div class="logo-insuco">
                    <!-- Imagen identificativa del establecimiento -->
                    <img src="E:\proyectodiseñoweb\Informaciondelabs\insuco.jpg" alt="Logo del liceo">
                    <span>Instituto Superior de Comercio Francisco Araya Bennett</span>
                </div>
                <!-- Enlaces que llevan a las otras páginas del sitio -->
                <div class="nav-links">
            <a href="E:\proyectodiseñoweb\Sobremi\yo.html">Administradores</a>
            <a href="../Presentacion/Presentacion.html">Presentación</a>
            <a href="../Contactarme/Comunicarme.html">Contacto</a>
            <a href="../Reserva/Reservaciones.html">Reservaciones</a>
