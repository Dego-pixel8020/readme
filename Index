        </header>

        <!-- Contenido principal de la página de laboratorios -->
        <main class="container" id="inicio">
            <!-- Presentación inicial con el título y accesos rápidos -->
            <section class="hero">
                <div class="hero-text">
                    <!-- Texto introductorio sobre el objetivo de la página -->
                    <p class="eyebrow">Instituto Superior de Comercio</p>
                    <h1>Laboratorios Instituto Superior de Comercio Francisco Araya Bennett</h1>
                    <p>
                        Aquí podrás consultar la disponibilidad, horarios y actividades de cada laboratorio
                        del establecimiento, con información clara y organizada para facilitar su uso
                    </p>
                    <div class="hero-actions">
                        <a href="#informacion" class="btn btn-primary">Ver información</a>
                        <a href="#laboratorios" class="btn btn-secondary">Consultar laboratorios</a>
                    </div>
                </div>
                
                <!-- Logo destacado que acompaña la presentación -->
                <div class="hero-visual">
                    <img src="insuco.jpg" alt="Logo del liceo">
                </div>
            </section>

            <!-- Información general; el id permite llegar aquí desde un enlace interno -->
            <section class="info-panel" id="informacion">
                <h2>Información general</h2>
                <p>
                    En esta página encontrarás información útil sobre cada laboratorio del liceo, incluyendo
                    horarios de uso, disponibilidad, actividades que se realizan y más. Nuestro objetivo es
                    que la consulta sea sencilla, moderna y accesible para toda la comunidad escolar
                </p>
            </section>
            <!-- Tarjetas resumidas con los principales datos que se pueden consultar -->
            <section class="card-grid" aria-label="Información de laboratorios">
                <div class="cards" id="laboratorios">
                    <article class="card">
                        <i>01</i>
                        <h3>Disponibilidad</h3>
                        <p>Consulta en qué momentos cada laboratorio está libre o en uso</p>
                    </article>

                    <article class="card">
                        <i>02</i>
                        <h3>Horarios</h3>
                        <p>Organiza mejor tus actividades según los turnos y tiempos de uso</p>
                    </article>

                    <article class="card">
                        <i>03</i>
                        <h3>Laboratorios</h3>
                        <p>Conoce la función de cada ambiente y su uso dentro del establecimiento</p>
                    </article>
                </div>
            </section>
            <!-- Tabla con el horario y el estado actual de cada laboratorio -->
            <section class="status">
                <h3>Estado de laboratorios</h3>
                <table>
                    <!-- Encabezados que describen las columnas de la tabla -->
                    <thead>
                        <tr>
                            <th>Laboratorio</th>
                            <th>Horario</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <!-- Filas con los datos de cada laboratorio -->
                    <tbody>
                        <tr>
                            <td>Laboratorio 1</td>
                            <td>08:30 - 17:00</td>
                            <td><span class="estado ok">disponible</span></td>
                        </tr>
                        <tr>
                            <td>Laboratorio 2</td>
                            <td>09:15 - 17:00</td>
                            <td><span class="estado ocupado">ocupado</span></td>
                        </tr>
                        <tr>
                            <td>Laboratorio 3</td>
                            <td>10:25 - 17:00</td>
                            <td><span class="estado ok">disponible</span></td>
                        </tr>
                        <tr>
                            <td>Laboratorio 4</td>
                            <td>08:30 - 17:00</td>
                            <td><span class="estado ocupado">ocupado</span></td>
                        </tr>
                        <tr>
                            <td>Laboratorio 5</td>
                            <td>11:15 - 17:00</td>
                            <td><span class="estado ok">disponible</span></td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </main>
