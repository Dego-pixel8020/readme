        <!-- Contenido principal de la página de laboratorios -->
        <main class="container" id="inicio">
            <!-- Presentación inicial con el título y accesos rápidos -->
            <section class="hero">
                <div class="hero-text">
                    <!-- Texto introductorio sobre el objetivo de la página -->
                    <p class="eyebrow">Instituto Superior de Comercio</p>
                    <h1>Laboratorios Instituto Superior de Comercio Francisco Araya Bennett</h1>
                    <p>
                        Aquí podrás consultar la disponibilidad, horarios y actividades de cada laboratorio
