                            <td><a class="btn btn-primary btn-small" href="../Lab4/laboratorio4.html">Ver ficha</a></td>
                        </tr>
                        <tr>
                            <td>Laboratorio 5</td>
                            <td>2-J, 3-C, 3-F</td>
                            <td><a class="btn btn-primary btn-small" href="../Lab5/laboratorio5.html">Ver ficha</a></td>
                        </tr>
                    </tbody>
                </table>
